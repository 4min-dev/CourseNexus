                      </div>
                    </li>
                  </ul>
                </CardContent>
              </Card>

              <Card className="border-2 border-chart-2/20">
                <CardHeader>
                  <div className="flex items-center gap-3 mb-4">
                    <div className="h-14 w-14 rounded-xl bg-chart-2/10 flex items-center justify-center">
