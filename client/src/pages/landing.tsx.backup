                  </div>
                  <div className="flex items-center gap-2">
                    <Check className="h-4 w-4 text-chart-2" />
                    <span>Отмена в любой момент</span>
                  </div>
                </div>
              </CardContent>
            </Card>
          </div>
        </section>
      </main>

      <Footer />
    </div>
  );
